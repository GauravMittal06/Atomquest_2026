---
title: AtomQuest Goal Tracking Portal — System Architecture
config:
  flowchart:
    curve: basis
    padding: 28
    nodeSpacing: 55
    rankSpacing: 70
  theme: base
  themeVariables:
    fontSize: 18px
    fontFamily: arial
---
flowchart TB
    LEGEND["LEGEND
    Solid = runtime data flow
    Dotted = spec / governance
    → request   ← response"]

    subgraph DOCS["docs/ — Business and Technical Specifications"]
        direction LR
        D1["BRD.md"]
        D2["VALIDATION_RULES.md"]
        D3["ROLE_PERMISSIONS.md"]
        D4["WORKFLOWS.md"]
        D5["CHECKIN_RULES.md"]
        D6["SHARED_GOALS.md"]
        D7["REPORTING_REQUIREMENTS.md"]
    end

    USER(("End Users"))
    subgraph RBAC["Role-Based Access Control"]
        direction LR
        R_EMP["Employee"]
        R_MGR["Manager"]
        R_ADM["Admin"]
    end
    USER --> RBAC

    subgraph FE["TIER 1 — Frontend · Vercel"]
        direction TB
        FE_STACK["React · Vite · TypeScript · Tailwind · shadcn/ui"]
        LOGIN["LoginPage
        POST /api/auth/token"]
        AUTH["AuthContext + RequireAuth
        JWT in localStorage"]
        AXIOS["Axios api.ts
        Bearer token"]
        subgraph FE_UI["Role-Scoped UI"]
            direction TB
            UI_EMP["Employee
            Dashboard · Goals · Check-ins"]
            UI_MGR["Manager
            Approvals · Review · Check-in Review"]
            UI_ADM["Admin
            Users · Goal Sheets · Reports · Escalations"]
        end
    end

    R_EMP --> UI_EMP
    R_MGR --> UI_MGR
    R_ADM --> UI_ADM
    LOGIN --> AUTH --> AXIOS --> FE_UI

    subgraph BE["TIER 2 — Backend API · Render"]
        direction TB
        FASTAPI["FastAPI
        CORS · lifespan · Motor client"]
        JWT["JWT auth.py
        OAuth2 Bearer · require_roles"]
        subgraph ROUTERS["REST API — grouped by domain"]
            direction LR
            RT_AUTH["Auth
            /api/auth
            /api/users"]
            RT_GOALS["Goal Management
            /api/goalsheets
            /api/goals"]
            RT_CHECKIN["Check-ins
            /api/checkins
            /api/checkin-comments"]
            RT_KPI["Shared KPIs
            /api/shared-kpis"]
            RT_MGR_ADMIN["Manager & Admin
            /api/manager
            /api/admin
            /api/admin/dashboard
            /api/employee/dashboard
            /api/escalations"]
            RT_SYSTEM["System
            /api/system
            /api/cycle-status"]
        end
        subgraph SERVICES["Domain Services"]
            direction LR
            S1["live_scoring"]
            S2["escalation_engine"]
            S3["quarter_visibility"]
            S4["quarter_snapshots"]
        end
        MOTOR["Motor async ODM"]
    end

    FASTAPI --> JWT --> ROUTERS
    ROUTERS --> SERVICES --> MOTOR

    subgraph DB["TIER 3 — Database · MongoDB Atlas"]
        direction TB
        MONGO[("MongoDB cluster")]
        subgraph COLL_CORE["Core collections"]
            direction LR
            C1[("users")]
            C2[("goal_sheets")]
            C3[("goals")]
            C4[("checkins")]
            C5[("audit_log")]
        end
        COLL_SUPP[("Supporting collections
        shared_kpis · checkin_comments
        escalations · appraisal_periods · system")]
    end

    DOCS -.->|"governs rules and permissions"| FE_STACK
    DOCS -.->|"governs validation and workflows"| FASTAPI

    AXIOS -->|"HTTPS REST → Request JSON"| FASTAPI
    FASTAPI -->|"HTTPS REST ← Response JSON"| AXIOS

    MOTOR -->|"async write persist"| MONGO
    MONGO -->|"async read query"| MOTOR

    RT_AUTH -.->|"issue JWT"| JWT
    RT_AUTH --> C1
    RT_GOALS --> C2
    RT_GOALS --> C3
    RT_GOALS -.-> C5
    RT_CHECKIN --> C4
    RT_CHECKIN --> COLL_SUPP
    RT_CHECKIN -.-> C3
    RT_KPI --> COLL_SUPP
    RT_MGR_ADMIN --> COLL_SUPP
    RT_SYSTEM --> COLL_SUPP

